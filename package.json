{
  "name": "milioai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:offline": "vite --mode offline --host 127.0.0.1",
    "test:offline:browser": "node scripts/offline-browser-check.cjs",
    "test:ux:browser": "node scripts/ux-browser-check.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "format": "prettier --write src scripts *.json *.ts *.js index.html README.md docs/*.md",
    "format:check": "prettier --check src scripts *.json *.ts *.js index.html README.md docs/*.md",
    "test:browser": "node scripts/browser-check.cjs",
    "test:operational:browser": "node scripts/operational-browser-check.cjs",
    "test:transport:browser": "node scripts/transport-browser-check.cjs"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "^5.2.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.3.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
