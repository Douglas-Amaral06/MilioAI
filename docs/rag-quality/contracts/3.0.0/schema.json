    },
    "question": {
      "type": "string"
    },
    "http_status": {
      "type": "integer"
    },
    "technical_contract_passed": {
      "type": "boolean"
    },
    "persisted": {
      "type": "boolean"
    },
    "human_acceptance": {
      "type": "null"
    },
    "message": {
      "type": "object"
    },
    "trace": {
      "type": "array"
    }
  }
}
