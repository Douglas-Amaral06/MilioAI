              "version": "folha-ponto-local-v1",
              "page": 2,
              "section": "7. Responsabilidade",
              "sha256": "9189523d33117828abbb79e53ed0735683462d24b8bef24fc3cf79cee88d095b",
              "chunk": 7,
              "excerpt": "7.\nResponsabilidade\nO correto preenchimento e envio da Folha Ponto é uma responsabilidade\ncompartilhada entre:\n• Jovem Aprendiz\n• Gestor/Mentor\n• Empresa parceira\nO RH Jovem realiza conferência, mas não substitui o preenchimento na origem.",
              "is_test": false,
              "validation_only": true,
              "score": 0.630612,
              "status": "approved"
            }
          ],
          "duration_ms": 2193
        }
