# Copy to .env; generate POSTGRES_PASSWORD and DEV_AUTH_TOKEN locally. Never commit .env.
POSTGRES_USER=milioai
POSTGRES_DB=milioai
POSTGRES_PASSWORD=
APP_ENV=development
AUTH_MODE=jwt
# Explicit local-only alternative: AUTH_MODE=development and a random DEV_AUTH_TOKEN (>=32 chars).
DEV_AUTH_TOKEN=
DATABASE_URL=
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_THINK=false
EMBEDDING_MODEL=nomic-embed-text-v2-moe:latest
EMBEDDING_DIMENSIONS=768
EMBEDDING_QUERY_PREFIX=search_query: 
EMBEDDING_DOCUMENT_PREFIX=search_document: 
OLLAMA_TIMEOUT=120
GENERATION_LIMIT=600
CONTEXT_SIZE=4096
ACTIVE_KB_VERSION=test-v1
RAG_MAX_DISTANCE=0.45
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
# Supabase asymmetric signing keys only (RS256/ES256), not legacy shared-secret JWTs.
JWT_ISSUER=
JWT_AUDIENCE=authenticated
JWT_JWKS_URL=
STORAGE_PATH=/data/private
UPLOAD_MAX_BYTES=5242880

# Public Supabase frontend settings (optional; never use a service-role key).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# RAG 02: opt in locally after ingesting the supplied PDF with --local-review.
RAG_TOP_K=3
RAG_PROFILE=sections-v3-contextual
DEV_DOCUMENT_SCOPES=[]
